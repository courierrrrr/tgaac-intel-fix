+/* Gfx8 (and older) samplers pick the wrong texel when a non-fragment-stage
+ * sample with a texel offset lands exactly on a texel edge with nearest
+ * filtering (seen in The Great Ace Attorney Chronicles' bone-matrix fetches,
+ * where characters lose most of their geometry). Fold the offset into the
+ * coordinate and nudge it 1/256 of a texel inward, which is below the
+ * sampler's sub-texel precision and therefore invisible for linear filtering.
+ * Disable with ELK_KEEP_VTX_TEX_OFFSET=1.
+ */
+static bool
+lower_vtx_tex_offset_nudge(nir_builder *b, nir_tex_instr *tex, void *data)
+{
+   if (tex->op != nir_texop_tex && tex->op != nir_texop_txl &&
+       tex->op != nir_texop_txb && tex->op != nir_texop_txd)
+      return false;
+
+   if (tex->sampler_dim == GLSL_SAMPLER_DIM_RECT)
+      return false;
+
+   int coord_index = nir_tex_instr_src_index(tex, nir_tex_src_coord);
+   if (coord_index < 0 ||
+       nir_tex_instr_src_type(tex, coord_index) != nir_type_float)
+      return false;
+
+   nir_def *offset = nir_steal_tex_src(tex, nir_tex_src_offset);
+   if (!offset)
+      return false;
+
+   nir_def *coord = tex->src[coord_index].src.ssa;
+
+   b->cursor = nir_before_instr(&tex->instr);
+
+   nir_def *txs = nir_i2f32(b, nir_build_texture_query(b, tex, nir_texop_txs,
+                                                       offset->num_components,
+                                                       nir_type_int32,
+                                                       false, true));
+   nir_def *shift = nir_fadd_imm(b, nir_i2f32(b, offset), 1.0 / 256.0);
+   nir_def *offset_coord = nir_fadd(b, coord,
+                                    nir_fmul(b, shift, nir_frcp(b, txs)));
+
+   if (tex->is_array) {
+      unsigned a = tex->coord_components - 1;
+      offset_coord = nir_vector_insert_imm(b, offset_coord,
+                                           nir_channel(b, coord, a), a);
+   }
+
+   nir_src_rewrite(&tex->src[coord_index].src, offset_coord);
+   return true;
+}
